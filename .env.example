# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
# Use the SECRET key (sb_secret_...) for server-side scripts — bypasses RLS.
SUPABASE_SECRET_KEY=sb_secret_...
# Anon/publishable keys are for the dashboard (client-side), not these scripts.
SUPABASE_ANON_KEY=eyJ...
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Google Cloud OAuth (one app, many user accounts) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8765/oauth/callback

# --- Notifications ---
# Side account where Bashir sends the "you have replies to write" nudge.
NOTIFY_TO_EMAIL=
# Which Gmail account in `accounts` table Bashir uses to SEND the nudge.
NOTIFY_FROM_EMAIL=

# --- Prompt versioning ---
# Bumped manually when prompts/triage.md changes. Stored on each classification row.
PROMPT_VERSION=1.0

# Note: there is NO ANTHROPIC_API_KEY. Classification is done by Claude itself
# inside the Claude Code Routine (Max subscription) — not via the paid API.
# See CLAUDE.md for the routine prompt.
